# =========================================================================
# Devin API
# =========================================================================
# Get from Cognition: API key is prefixed with "cog_"
DEVIN_API_KEY=cog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEVIN_ORG_ID=org_xxxxxxxxxxxxxxxxxxxxxxxx
DEVIN_API_BASE=https://api.devin.ai/v3

# Set to "mock" to use the in-process Mock Devin (no key needed).
# Set to "real" to call api.devin.ai. Default: mock.
DEVIN_MODE=mock

# Hard cap on ACU burn per session. Always set this.
DEVIN_MAX_ACU_PER_SESSION=3

# =========================================================================
# GitHub
# =========================================================================
# gh CLI handles its own auth, but the orchestrator container needs this.
# Personal access token with `repo` scope is sufficient for the demo.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=gacerioni/superset
# Optional shared secret for webhook signature verification.
GITHUB_WEBHOOK_SECRET=change-me-in-prod
# Label that signals "Devin should fix this issue"
GITHUB_REMEDIATE_LABEL=devin-remediate

# =========================================================================
# Redis (Redis Cloud by default; local Redis Stack is opt-in via compose profile)
# =========================================================================
# Redis Cloud URL — format:  rediss://default:<password>@<host>:<port>
# For local Redis Stack instead:  redis://redis:6379/0
REDIS_URL=rediss://default:CHANGE_ME@your-endpoint.c123.us-east-1-2.ec2.cloud.redislabs.com:12345

# =========================================================================
# App
# =========================================================================
APP_ENV=dev
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=30
